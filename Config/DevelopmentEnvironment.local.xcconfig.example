// 复制为 DevelopmentEnvironment.local.xcconfig 后填写 Development 环境公开配置。
// 私钥、Session 密钥和 Apple p8 内容不得写入此文件。
XC_SLASH = /
IDENTITY_WORKER_URL = https:$(XC_SLASH)$(XC_SLASH)replace-with-development-worker.workers.dev
// 如果公钥 Base64 中含有斜杠，也必须写成 $(XC_SLASH)，避免被 xcconfig 当成注释。
CAPABILITY_SIGNING_PUBLIC_KEY_PEM = -----BEGIN PUBLIC KEY-----\nREPLACE_WITH_P256_PUBLIC_KEY\n-----END PUBLIC KEY-----
