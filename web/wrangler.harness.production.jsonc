{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esheepplus-harness",
  "main": "./container/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{
    "class_name": "HarnessContainer",
    "image": "registry.cloudflare.com/19903f0d75fedc224e6e398c6eaa5cbe/esheepplus-harness@sha256:8c6f8f140beeb897b3514954a865247d6d29ad5c52cd57ffd4b7fe50e8e2b85c",
    "image_build_context": ".",
    "instance_type": "basic",
    "max_instances": 2
  }],
  "durable_objects": { "bindings": [{ "name": "HARNESS_CONTAINER", "class_name": "HarnessContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HarnessContainer"] }],
  "observability": { "enabled": false }
}
