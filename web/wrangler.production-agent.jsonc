{
  "name": "esheepplus-production-assistant",
  "main": "./worker/production-agent.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "services": [{ "binding": "BACKEND_STATUS", "service": "esheepplus-backend-status" }],
  "routes": [{ "pattern": "https://app.esheepplus.com/api/assistant/agent/*", "zone_name": "esheepplus.com" }]
}
