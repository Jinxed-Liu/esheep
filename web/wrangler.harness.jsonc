{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esheepplus-harness-staging",
  "main": "./container/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{
    "class_name": "HarnessContainer",
    "image": "registry.cloudflare.com/19903f0d75fedc224e6e398c6eaa5cbe/esheepplus-agent@sha256:255f8afff6e9bda8fe94364722c8adbacfdcebc44f2323f11d4abf4a8f1a413b",
    "image_build_context": "..",
    "instance_type": "basic",
    "max_instances": 2
  }],
  "durable_objects": { "bindings": [{ "name": "HARNESS_CONTAINER", "class_name": "HarnessContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HarnessContainer"] }],
  "observability": { "enabled": false }
}
