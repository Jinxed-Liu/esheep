{
  "name": "esheepplus-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:excel-template": "node scripts/sync-app-excel-template.mjs",
    "dev": "npm run sync:excel-template && node server/dev.mjs",
    "dev:frontend": "npm run sync:excel-template && vite",
    "build": "npm run sync:excel-template && vite build && node scripts/prepare-sites-build.mjs",
    "cloudflare:check": "npm run build && wrangler deploy --dry-run --env production",
    "cloudflare:deploy:staging": "npm run build && wrangler deploy --env staging",
    "cloudflare:deploy:production": "npm run build && wrangler deploy --env production",
    "preview": "node server/serve.mjs",
    "start": "node server/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:projection": "node --test tests/workspace-projection.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.151.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.112.3",
    "@vitejs/plugin-react": "5.0.4",
    "fflate": "0.8.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
