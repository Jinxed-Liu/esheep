{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esheepplus-web",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/assistant/*"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "esheepplus-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "staging.esheepplus.com",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "esheepplus-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "app.esheepplus.com",
          "custom_domain": true
        }
      ]
    }
  }
}
