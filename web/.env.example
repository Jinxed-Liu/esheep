VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# MiMo API Key 不放在服务端环境变量中。每个已登录用户在助手界面填写自己的 Key。

# Optional server settings:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Only for a self-hosted MiMo-compatible endpoint. Normal sk-/tp- keys choose their endpoint automatically.
# MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
# CODEX_HARNESS_STATE_DIR=/absolute/private/runtime/path
# CODEX_HARNESS_SESSION_TTL_MINUTES=720
