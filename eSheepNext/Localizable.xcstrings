        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the farm owner can edit names, up to 80 characters each. The English or Pinyin name syncs to farm members and appears on share posters. Leave it blank to hide the line. Existing sheep and history are preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅牧场所有者可以修改名称，每项最多 80 个字符。英文名或拼音名为全局牧场资料，会同步给牧场成员并用于分享海报；留空时海报隐藏此行。现有羊只和历史记录全部保留。"
          }
